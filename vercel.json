{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "server": {
      "root": "server",
      "framework": "fastify",
      "entrypoint": "src/index.ts",
      "bindings": [
        { "type": "service", "service": "worker", "format": "url", "env": "WORKER_URL" }
      ]
    },
    "web": {
      "root": "web",
      "framework": "vite",
      "rewrites": [
        { "source": "/(.*)", "destination": "/index.html" }
      ]
    },
    "worker": {
      "root": "worker",
      "runtime": "python",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "server" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
