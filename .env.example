# Copy to .env and adjust. Never commit .env.

# Database: a postgres:// URL (PostgreSQL / Supabase connection string, server-side only)
# or a folder path for the embedded PGlite database used in local development.
DATABASE_URL=data/pglite
# Set to true for managed Postgres that requires TLS (e.g. Supabase)
DATABASE_SSL=false

# Where uploaded documents and generated bills are stored
STORAGE_DIR=data/files
MAX_UPLOAD_MB=25

PORT=4000
HOST=127.0.0.1
SESSION_HOURS=12
# true when served over HTTPS
COOKIE_SECURE=false

# Python document worker (defaults to worker/.venv)
# PYTHON_BIN=worker/.venv/Scripts/python.exe

# Optional AI extraction of contract terms. Leave empty to use rule-based extraction only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Hosting without a lasting disk (Vercel) ---------------------------------
# On Vercel these are set automatically: files are kept in the database, uploads are
# limited to 4 MB (Vercel's request limit is 4.5 MB) and cookies are HTTPS-only.
# STORE_FILES_IN_DB=true
# Document worker as a web service; Vercel injects this through the service binding.
# WORKER_URL=
